<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
<title>Calculator</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  body { min-height: 100vh; background: #0F0F1A; display: flex; align-items: center; justify-content: center; font-family: 'Courier New', monospace; }
  .calc { background: #1A1A2E; border-radius: 24px; padding: 24px; width: 320px; box-shadow: 0 25px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.05); }
  .display { background: #0F0F1A; border-radius: 14px; padding: 20px 20px 16px; margin-bottom: 20px; min-height: 96px; display: flex; flex-direction: column; align-items: flex-end; justify-content: flex-end; border: 1px solid rgba(255,255,255,0.06); }
  .expression { color: #4A4A6A; font-size: 14px; margin-bottom: 6px; min-height: 18px; }
  .value { color: #F0F0F0; font-size: 42px; font-weight: bold; text-shadow: 0 0 20px rgba(123,97,255,0.3); word-break: break-all; line-height: 1; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  button { border: none; border-radius: 12px; font-size: 18px; font-family: 'Courier New', monospace; font-weight: 600; height: 64px; cursor: pointer; transition: transform 0.08s; width: 100%; }
  button:active { transform: scale(0.93); }
  .digit { background: #2A2A3E; color: #F0F0F0; }
  .utility { background: #2A2A3E; color: #A0A0C0; font-size: 15px; }
  .operator { background: #E94560; color: #fff; box-shadow: 0 4px 15px rgba(233,69,96,0.3); }
  .equals { background: linear-gradient(135deg,#7B61FF,#E94560); color: #fff; box-shadow: 0 4px 20px rgba(123,97,255,0.4); }
  .zero { grid-column: span 2; background: #2A2A3E; color: #F0F0F0; text-align: left; padding-left: 22px; }
</style>
</head>
<body>
<div class="calc">
  <div class="display">
    <div class="expression" id="expr"></div>
    <div class="value" id="val">0</div>
  </div>
  <div class="grid">
    <button class="utility" onclick="clear_()">AC</button>
    <button class="utility" onclick="toggleSign()">+/−</button>
    <button class="utility" onclick="percent()">%</button>
    <button class="operator" onclick="setOp('÷')">÷</button>
    <button class="digit" onclick="digit(7)">7</button>
    <button class="digit" onclick="digit(8)">8</button>
    <button class="digit" onclick="digit(9)">9</button>
    <button class="operator" onclick="setOp('×')">×</button>
    <button class="digit" onclick="digit(4)">4</button>
    <button class="digit" onclick="digit(5)">5</button>
    <button class="digit" onclick="digit(6)">6</button>
    <button class="operator" onclick="setOp('−')">−</button>
    <button class="digit" onclick="digit(1)">1</button>
    <button class="digit" onclick="digit(2)">2</button>
    <button class="digit" onclick="digit(3)">3</button>
    <button class="operator" onclick="setOp('+')">+</button>
    <button class="zero" onclick="digit(0)">0</button>
    <button class="digit" onclick="decimal()">.</button>
    <button class="equals" onclick="equals()">=</button>
  </div>
</div>
<script>
  let display='0', expr='', prev=null, op=null, waiting=false;
  const V=()=>document.getElementById('val');
  const E=()=>document.getElementById('expr');
  const update=()=>{ V().textContent=display; V().style.fontSize=display.length>9?'28px':'42px'; E().textContent=expr; }
  function digit(d){ if(waiting){display=String(d);waiting=false;}else{display=display==='0'?String(d):display+d;} update(); }
  function decimal(){ if(waiting){display='0.';waiting=false;}else if(!display.includes('.'))display+='.'; update(); }
  function clear_(){ display='0';expr='';prev=null;op=null;waiting=false; update(); }
  function toggleSign(){ display=String(parseFloat(display)*-1); update(); }
  function percent(){ display=String(parseFloat(display)/100); update(); }
  function calc(a,b,o){ if(o==='+')return a+b; if(o==='−')return a-b; if(o==='×')return a*b; if(o==='÷')return b?a/b:0; return b; }
  function fmt(n){ return String(parseFloat(n.toPrecision(10))); }
  function setOp(o){
    const cur=parseFloat(display);
    if(prev!==null&&!waiting){ const r=calc(prev,cur,op); display=fmt(r); prev=r; expr=display+' '+o; }
    else{ prev=cur; expr=display+' '+o; }
    op=o; waiting=true; update();
  }
  function equals(){
    if(prev===null||op===null)return;
    const cur=parseFloat(display), r=calc(prev,cur,op);
    expr=prev+' '+op+' '+display+' =';
    display=fmt(r); prev=null; op=null; waiting=true; update();
  }
</script>
</body>
</html>
